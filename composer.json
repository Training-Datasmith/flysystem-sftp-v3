{
    "name": "league/flysystem-sftp-v3",
    "description": "SFTP filesystem adapter for Flysystem.",
    "keywords": ["flysystem", "filesystem", "sftp", "files", "file"],
    "autoload": {
        "psr-4": {
            "League\\Flysystem\\PhpseclibV3\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "League\\Flysystem\\PhpseclibV3\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.0.2",
        "league/flysystem": "^3.0.14",
        "league/mime-type-detection": "^1.0.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6.38"
    },
    "config": {
        "platform": {
            "php": "8.0.2"
        }
    },
    "license": "MIT",
